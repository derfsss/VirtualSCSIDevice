; virtioscsi.device Autoinstall
; Installs VirtIO SCSI device driver for AmigaOS 4.1 Final Edition
;
; Run from the VirtualSCSIDevice distribution directory:
;   Execute Autoinstall
;
; Files installed automatically:
;   SYS:Kickstart/virtioscsi.device  - VirtIO SCSI device driver
;
; After installation, you must manually add the driver to your
; Kicklayout file (see instructions at end).

echo ""
echo "virtioscsi.device -- VirtIO SCSI for AmigaOS 4.1 FE"
echo "====================================================="
echo ""

; Check the driver file exists in our distribution
if not exists virtioscsi.device
  echo "ERROR: virtioscsi.device not found in current directory."
  echo "Please run this script from the VirtualSCSIDevice directory."
  quit 20
endif

; Check that SYS:Kickstart exists
if not exists SYS:Kickstart
  echo "ERROR: SYS:Kickstart directory not found."
  echo "This installer requires AmigaOS 4.1 Final Edition."
  quit 20
endif

; Install the device driver
echo "Installing virtioscsi.device to SYS:Kickstart/..."
copy virtioscsi.device SYS:Kickstart/virtioscsi.device CLONE QUIET
if warn
  echo "ERROR: Failed to copy virtioscsi.device to SYS:Kickstart/"
  echo "Check that SYS: is not write-protected."
  quit 20
endif

echo ""
echo "Installation complete."
echo ""
echo "====================================================="
echo "IMPORTANT: You must add the driver to your Kicklayout"
echo "file before it will load at boot."
echo ""
echo "Edit SYS:Kickstart/Kicklayout and add this line after"
echo "the existing boot device driver entry (e.g. after the"
echo "a1ide.device.kmod or peg2ide.device.kmod line):"
echo ""
echo "  MODULE Kickstart/virtioscsi.device"
echo ""
echo "If using BBoot, add the same line to the Kicklayout"
echo "inside your BBoot zip archive instead."
echo ""
echo "Then reboot to activate the driver."
echo "====================================================="
echo ""
echo "QEMU setup (add to your QEMU command line):"
echo ""
echo "  AmigaOne:  -device virtio-scsi-pci,id=scsi0"
echo "  Pegasos2:  -device virtio-scsi-pci-non-transitional,id=scsi0"
echo ""
echo "  Then add drives:"
echo "  -drive file=disk.img,if=none,id=vd0,format=raw"
echo "  -device scsi-hd,drive=vd0,bus=scsi0.0,channel=0,scsi-id=0,lun=0"
echo ""
